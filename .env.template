# Copy to .env and fill in. .env is not committed.

# Folder name of the Firefox profile to deploy to, e.g. profiles.dev-edition-default
# (about:support → Profile Folder; the last part of the path)
FIREFOX_PROFILE=

# Optional: the folder holding the profiles, if not the default
# (Windows: %APPDATA%\Mozilla\Firefox\Profiles)
# FIREFOX_PROFILES_DIR=

# Optional: the Browser Toolbox's RDP port. Leave empty to detect it (it changes every time
# the toolbox opens); a single run can also take `task <name> PORT=1234`.
# FIREFOX_RDP_PORT=
